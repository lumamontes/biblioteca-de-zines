# Public origin used in links that the portal writes to GitHub.
PARTICIPATION_PUBLIC_ORIGIN=http://localhost:4200
# Where "Biblioteca de Zines" in the header leads.
PARTICIPATION_CATALOGUE_URL=http://localhost:3000
# GitHub logins allowed to answer officially (comma separated).
PARTICIPATION_MAINTAINERS=lumamontes
# HMAC secret for anonymous voter tokens. Required once the real GitHub gateway exists.
PARTICIPATION_VOTER_SECRET=change-me
# Enables /triage against the simulated GitHub. Never enabled with a real gateway.
PARTICIPATION_LOCAL_TRIAGE=1
# Simulated GitHub failure on the first publication of each comment: none | lost-confirmation | unavailable
PARTICIPATION_GITHUB_FAILURE=none
# default | extreme (adds content at the extremes to check layout)
PARTICIPATION_SEED=default
# Optional: where the local JSON files live (defaults to ./.data, or the temp dir on Vercel).
# PARTICIPATION_DATA_DIR=.data
