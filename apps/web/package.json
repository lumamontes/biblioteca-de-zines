    "process:pending-zines": "node --import ./scripts/load-env.mjs --import tsx scripts/process-pending-zines.ts",
    "observe:source-metadata": "node --import ./scripts/load-env.mjs --import tsx scripts/observe-source-metadata.ts",
    "check-types": "tsc --noEmit"
