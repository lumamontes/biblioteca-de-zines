{
  "name": "biblioteca-de-zines-monorepo",
  "version": "0.1.0",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter biblioteca-zines dev",
    "dev:all": "pnpm exec turbo dev --parallel",
    "build": "pnpm --filter biblioteca-zines build",
    "start": "pnpm --filter biblioteca-zines start",
    "lint": "pnpm --filter biblioteca-zines lint",
    "test": "pnpm --filter biblioteca-zines test",
    "test:cover": "pnpm --filter biblioteca-zines test:cover",
    "test:application": "pnpm --filter biblioteca-zines test:application",
    "test:inventory": "pnpm --filter biblioteca-zines test:inventory",
    "archive:inventory": "pnpm --filter biblioteca-zines archive:inventory",
    "reading:derivative-spike": "pnpm --filter biblioteca-zines reading:derivative-spike",
    "reading:derivative-benchmark": "pnpm --filter biblioteca-zines reading:derivative-benchmark",
    "reader:performance-benchmark": "pnpm --filter biblioteca-zines reader:performance-benchmark",
    "migrate:pdf-covers": "pnpm --filter biblioteca-zines migrate:pdf-covers",
    "migrate:pdf-pages": "pnpm --filter biblioteca-zines migrate:pdf-pages",
    "generate:form-upload-cover": "pnpm --filter biblioteca-zines generate:form-upload-cover",
    "process:pending-zines": "pnpm --filter biblioteca-zines process:pending-zines"
  },
  "devDependencies": {
    "turbo": "^2.11.7"
  },
  "packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a"
}
